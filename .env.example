# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Todos os valores abaixo são ilustrativos.

# PostgreSQL. Em desenvolvimento use um banco local (docker compose up -d)
# ou um banco/branch gratuito do Neon (https://neon.com). Em produção, a
# connection string do Neon (use a conexão direta, com sslmode=require).
DATABASE_URL="postgresql://sinutre:sinutre@localhost:5432/sinutre?schema=public"

# Banco SEPARADO usado só por `npm test` (os testes apagam os dados dele).
TEST_DATABASE_URL="postgresql://sinutre:sinutre@localhost:5432/sinutre_test?schema=public"

# Servidor (na hospedagem a plataforma define PORT sozinha)
PORT=3333

# GitHub OAuth — crie um OAuth App em https://github.com/settings/developers
# Use um OAuth App para desenvolvimento e OUTRO para produção, porque cada
# app aceita uma única callback URL.
GITHUB_CLIENT_ID="seu-client-id"
GITHUB_CLIENT_SECRET="seu-client-secret"
# Local:    http://localhost:3333/auth/github/callback
# Produção: https://SEU-BACKEND.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL="http://localhost:3333/auth/github/callback"

# JWT — gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Origem do frontend (CORS e redirect após login), sem barra no final.
# Local:    http://localhost:5173
# Produção: https://SEU-FRONTEND.onrender.com
FRONTEND_URL="http://localhost:5173"
