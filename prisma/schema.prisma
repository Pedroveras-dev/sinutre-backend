// Schema do SiNutre — segue o modelo descrito em ../../modelo-nutricional.puml
// Para a aula, só User (login via GitHub) e Meal (cadastro de refeição) são exercitados,
// mas o domínio completo é modelado aqui para refletir o PlantUML.
//
// Observação: os campos que no PlantUML são GENDERCHOICE, MEALCHOICE e
// LEVELCHOICE ficam aqui como String; os valores válidos estão em
// src/constants/enums.ts. (O projeto original usava SQLite, que não suporta
// enums no Prisma 5; mantivemos String ao migrar para PostgreSQL para não
// mudar o modelo de dados.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL: o banco fica fora do servidor da aplicação, então os dados
  // sobrevivem a reinícios e novos deploys (o SQLite em arquivo se perderia
  // no disco efêmero da hospedagem gratuita).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  githubId    String    @unique
  githubLogin String    @unique
  name        String
  birthDate   DateTime? @map("birth_date")
  avatarUrl   String?   @map("avatar_url")
  gender      String    @default("NAO_ESPECIFICADO") // GENDERCHOICE
  createdAt   DateTime  @default(now()) @map("created_at")

  meals       Meal[]
  foods       Food[]
  weightLogs  WeightLog[]
  healthData  HealthData[]

  @@map("users")
}

model Meal {
  id          Int       @id @default(autoincrement())
  type        String    // MEALCHOICE
  eatTime     DateTime  @map("eat_time")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id])

  foods       MealFood[]

  @@map("meals")
}

model Food {
  id              Int        @id @default(autoincrement())
  name            String
  caloriesPer100g Float      @map("calories_per_100g")
  carbsPer100g    Float      @map("carbs_per_100g")
  proteinPer100g  Float      @map("protein_per_100g")
  fatPer100g      Float      @map("fat_per_100g")

  userId          Int        @map("user_id")
  user            User       @relation(fields: [userId], references: [id])

  meals           MealFood[]

  @@map("foods")
}

// Classe associativa Meal <-> Food (n para m)
model MealFood {
  mealId   Int   @map("meal_id")
  foodId   Int   @map("food_id")
  foodG    Float @map("food_g")
  calories Float
  carbs    Float
  protein  Float
  fat      Float

  meal Meal @relation(fields: [mealId], references: [id])
  food Food @relation(fields: [foodId], references: [id])

  @@id([mealId, foodId])
  @@map("meal_foods")
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  height    Float
  weight    Float
  createdAt DateTime @default(now()) @map("created_at")

  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  @@map("weight_logs")
}

// Um usuário pode ter vários registros (histórico), mas no máximo UM ativo:
// isActive = true e closedAt = null. Ao mudar a meta, o registro ativo é
// encerrado e um novo é criado (ver src/controllers/calorieGoal.controller.ts).
model HealthData {
  id               Int       @id @default(autoincrement())
  targetDietDaily  Int       @map("target_diet_daily") // meta diária em kcal
  // Opcional: a tela de meta de calorias não coleta o nível de atividade,
  // então não gravamos um valor inventado.
  levelActivity    String?   @map("level_activity") // LEVELCHOICE
  createdAt        DateTime  @default(now()) @map("created_at")
  closedAt         DateTime? @map("closed_at")
  isActive         Boolean   @default(true) @map("is_active")

  userId           Int       @map("user_id")
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, isActive])
  @@map("health_data")
}
